- content_for :title, "#{@app.name} · Monitor"

:css
  .modal-overlay { position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;z-index:1000 }
  .modal-box { background:#fff;border-radius:8px;width:min(960px,94vw);max-height:88vh;display:flex;flex-direction:column;box-shadow:0 8px 32px rgba(0,0,0,.18) }
  .modal-box__header { display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--border) }
  .modal-box__title { font-weight:600;font-size:14px }
  .modal-box__close { background:none;border:none;cursor:pointer;font-size:18px;color:var(--text-muted);line-height:1 }
  .modal-box__body { padding:16px 18px;overflow:auto;font-family:var(--mono);font-size:12px;white-space:pre;margin:0;flex:1 }
  .modal-box__iframe { flex:1;border:none;width:100%;min-height:340px }
  .syn-s { color:#059669 }
  .syn-n { color:#0284c7 }
  .syn-b { color:#dc2626 }
  .syn-k { color:#7c3aed }

= link_to "← Apps", synchify.apps_path, class: "back-link"

.page-header
  .page-header__title= @app.name
  %p.page-header__subtitle
    %code= @app.app_code

%nav.tabs
  = link_to "Overview", synchify.app_path(@app.app_code), class: "tab"
  = link_to "Events",   synchify.app_events_path(@app.app_code), class: "tab"
  = link_to "Monitor",  synchify.app_monitor_path(@app.app_code), class: "tab tab--active"

.filter-bar
  = form_with url: synchify.app_monitor_path(@app.app_code), method: :get, local: true do |f|
    .filter-group
      = f.label :direction, "Direction"
      = f.select :direction, [["All", ""], ["Incoming", "incoming"], ["Outgoing", "outgoing"]], { selected: params[:direction] }, { class: "filter-select" }
    .filter-group
      = f.label :event_name, "Event Name"
      = f.select :event_name, [["All", ""]] + @event_names.map { |n| [n, n] }, { selected: params[:event_name] }, { class: "filter-select" }
    .filter-group{style: "flex-direction:row;align-items:flex-end;gap:8px"}
      = f.submit "Filter", class: "btn btn--primary"
      - if params[:direction].present? || params[:event_name].present?
        = link_to "Clear", synchify.app_monitor_path(@app.app_code), class: "btn btn--ghost"

.table-wrap
  .table-wrap__header
    %span.table-wrap__title Event Logs
    %span.table-wrap__count= @logs.size
  - if @logs.any?
    %table
      %thead
        %tr
          %th Direction
          %th Event
          %th Status
          %th Event ID
          %th Request ID
          %th Time
          %th Payload
          %th Response
      %tbody
        - @logs.each do |log|
          %tr
            %td
              %span{class: "badge badge--#{log.direction}"}= log.direction
            %td
              %code{style: "font-size:11px"}= log.event_name
            %td
              - if log.status_code
                %span{class: "status-code #{status_code_class(log.status_code)}"}= log.status_code
              - elsif (err = log.metadata&.dig("error")).present?
                %span{style: "color:#dc2626;font-size:11px;font-family:var(--mono)", title: err} error
              - else
                %span{style: "color:var(--text-muted)"} —
            %td{style: "font-family:var(--mono);font-size:11px;color:var(--text-muted)"}= log.event_id&.truncate(16) || "—"
            %td{style: "font-family:var(--mono);font-size:11px;color:var(--text-muted)"}= log.request_id&.truncate(16) || "—"
            %td{style: "font-size:11px;color:var(--text-muted);white-space:nowrap"}= log.created_at.strftime("%b %d %H:%M:%S")
            %td
              - if log.payload.present?
                %button.btn.btn--ghost{type: "button", "data-json": log.payload.to_json, "data-title": "Payload", onclick: "synchifyShowModal(this)", style: "font-size:11px;padding:2px 8px"} View
              - else
                %span{style: "color:var(--text-muted)"} —
            %td
              - response_body = log.metadata&.dig("response_body")
              - if log.outgoing? && response_body.present?
                %button.btn.btn--ghost{type: "button", "data-json": response_body, "data-title": "Response", onclick: "synchifyShowModal(this)", style: "font-size:11px;padding:2px 8px"} View
              - else
                %span{style: "color:var(--text-muted)"} —
  - else
    .empty
      .empty__text No event logs found

#synchify-modal.modal-overlay{style: "display:none", onclick: "if(event.target===this)synchifyCloseModal()"}
  .modal-box
    .modal-box__header
      %span#synchify-modal-title.modal-box__title Data
      %button.modal-box__close{type: "button", onclick: "synchifyCloseModal()"} ✕
    %pre#synchify-modal-content.modal-box__body{style: "display:none"}
    %iframe#synchify-modal-frame.modal-box__iframe{style: "display:none", sandbox: "allow-same-origin"}

:javascript
  function synchifyHighlightJson(str) {
    return str.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g, function(m) {
      if (/^"/.test(m)) {
        return /:$/.test(m)
          ? '<span class="syn-k">' + m + '</span>'
          : '<span class="syn-s">' + m + '</span>';
      }
      if (/true|false/.test(m)) return '<span class="syn-b">' + m + '</span>';
      if (/null/.test(m))       return '<span class="syn-b">' + m + '</span>';
      return '<span class="syn-n">' + m + '</span>';
    });
  }

  function synchifyShowModal(btn) {
    var raw   = btn.getAttribute('data-json');
    var title = btn.getAttribute('data-title') || 'Data';
    document.getElementById('synchify-modal-title').textContent = title;

    var pre   = document.getElementById('synchify-modal-content');
    var frame = document.getElementById('synchify-modal-frame');

    var isHtml = /^\s*(<\!DOCTYPE|<html|<body|<div|<p|<table|<span|<ul|<li)/i.test(raw);
    var parsed = null;
    if (!isHtml) { try { parsed = JSON.parse(raw); } catch(e) {} }

    if (parsed !== null) {
      var pretty = JSON.stringify(parsed, null, 2);
      pre.innerHTML = synchifyHighlightJson(
        pretty.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      );
      pre.style.display = 'block';
      frame.style.display = 'none';
    } else if (isHtml) {
      frame.srcdoc = raw;
      frame.style.display = 'block';
      pre.style.display = 'none';
    } else {
      pre.textContent = raw;
      pre.style.display = 'block';
      frame.style.display = 'none';
    }

    document.getElementById('synchify-modal').style.display = 'flex';
  }

  function synchifyCloseModal() {
    document.getElementById('synchify-modal').style.display = 'none';
  }
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') synchifyCloseModal(); });
