- content_for :title, "Apps"
- content_for :head do
  :css
    .main__content { max-width: none; }

.page-header{style: "display:flex;justify-content:space-between;align-items:flex-start"}
  %div
    .page-header__title Apps
    %p.page-header__subtitle Connected applications managed by this Synchify instance
  .page-header__actions{style: "margin-top:0;flex-shrink:0"}
    = link_to "+ New App", synchify.new_connection_request_path, class: "btn btn--primary"

- if @pending_requests.any?
  .section-title
    Pending Requests
    %span.badge.badge--requested{style: "margin-left:6px"}= @pending_requests.size

  - @pending_requests.each do |cr|
    - app_code = cr.requester_info["app_code"]
    - app_name = cr.requester_info["app_name"].presence || app_code || "Unknown"
    - app_url  = cr.requester_info["app_url"].presence || "—"
    - raw_key  = cr.requester_info["api_key"].presence || cr.request_key.presence || ""
    - masked   = raw_key.length > 8 ? "#{raw_key[0..7]}••••••••" : raw_key
    .request-card
      .request-card__info
        .request-card__code= app_name
        .request-card__meta{style: "font-size:12px;color:var(--text-muted);margin-top:3px;word-break:break-all"}= app_url
        .request-card__meta{style: "font-size:11px;color:var(--text-muted);margin-top:2px;display:flex;gap:14px;flex-wrap:wrap"}
          %span= "Requested #{cr.created_at.strftime('%b %d, %H:%M')}"
          %span{style: "font-family:var(--mono)"}= masked
      .request-card__actions
        = form_with url: synchify.approve_connection_request_path(cr), method: :post, local: true do |f|
          = f.submit "Approve", class: "btn btn--success"
        = form_with url: synchify.reject_connection_request_path(cr), method: :post, local: true do |f|
          = f.submit "Reject", class: "btn btn--danger"

.section-title
  All Apps
  %span.table-wrap__count{style: "margin-left:8px;vertical-align:middle"}= @apps.size
- if @apps.any?
  .app-cards-grid
    - @apps.each do |app|
      .app-card
        .app-card__name= app.name
        %code{style: "font-size:11px;align-self:flex-start"}= app.app_code
        - if app.app_url.present?
          %span.app-card__url= app.app_url
        .app-card__footer
          .actions-row
            %span{class: "badge badge--#{app.status}"}= app.status
            %span{class: "badge badge--#{app.connection_state}"}= app.connection_state
          = link_to "View →", synchify.app_path(app.app_code), class: "link"
- else
  .empty
    .empty__icon ⬡
    .empty__text No apps registered yet
