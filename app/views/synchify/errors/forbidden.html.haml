!!! 5
%html
  %head
    %meta{charset: "UTF-8"}
    %meta{name: "viewport", content: "width=device-width, initial-scale=1.0"}
    %title Restricted Access
    :css
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: #f0f0f0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }
      .container { text-align: center; }
      .error-display {
        display: flex;
        align-items: center;
        justify-content: center;
        line-height: 1;
        margin-bottom: 28px;
      }
      .error-digit {
        font-size: 220px;
        font-weight: 900;
        color: #0d0d0d;
        letter-spacing: -8px;
      }
      .lock-wrap {
        width: 170px;
        height: 210px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 4px;
      }
      .title {
        font-size: 22px;
        font-weight: 700;
        color: #111;
        margin-bottom: 8px;
      }
      .subtitle {
        font-size: 14px;
        color: #666;
        margin-bottom: 24px;
      }
      .dev-hint {
        margin-top: 24px;
        padding: 14px 20px;
        background: #fff8e1;
        border: 1px solid #ffe082;
        border-radius: 8px;
        font-size: 13px;
        color: #5d4037;
        text-align: left;
        max-width: 480px;
        margin-left: auto;
        margin-right: auto;
      }
      .dev-hint code {
        background: #f5f0e0;
        padding: 1px 5px;
        border-radius: 3px;
        font-family: monospace;
        font-size: 12px;
      }
  %body
    .container
      .error-display
        %span.error-digit 4
        .lock-wrap
          %svg{xmlns: "http://www.w3.org/2000/svg", width: "170", height: "170", viewBox: "0 0 20 20"}
            %title Restricted Access
            %g{fill: "none"}
              %path{fill: "url(#grad-a)", d: "M10 2a8 8 0 1 1 0 16a8 8 0 0 1 0-16"}
              %path{fill: "url(#grad-b)", "fill-rule": "evenodd", d: "M10.5 6.5a.5.5 0 0 0-1 0V11a.5.5 0 0 0 1 0zM10 14a.75.75 0 1 0 0-1.5a.75.75 0 0 0 0 1.5", "clip-rule": "evenodd"}
              %defs
                %linearGradient#grad-a{x1: "4.5", x2: "15", y1: "-.5", y2: "19.5", gradientUnits: "userSpaceOnUse"}
                  %stop{"stop-color": "#ffcd0f"}
                  %stop{offset: "1", "stop-color": "#fe8401"}
                %linearGradient#grad-b{x1: "8", x2: "12", y1: "6", y2: "14", gradientUnits: "userSpaceOnUse"}
                  %stop{"stop-color": "#4a4a4a"}
                  %stop{offset: "1", "stop-color": "#212121"}
        %span.error-digit 3
      %h1.title Restricted Access
      %p.subtitle You lack permissions to access this page
      - if defined?(Rails) && Rails.env.development? && Synchify.configuration.authenticate_with.nil?
        .dev-hint
          %strong Development hint:
          %code authenticate_with
          is not configured. Set it in your Synchify initializer:
          %br
          %br
          %code config.authenticate_with = -> { redirect_to root_path unless current_user&.admin? }
